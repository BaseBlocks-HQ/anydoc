{
  "name": "@baseblocks/anydoc-contracts",
  "version": "0.2.0-alpha.5",
  "description": "Shared error, resource-limit, URL-safety, and untrusted-source contracts for AnyDoc",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BaseBlocks-HQ/anydoc.git",
    "directory": "packages/contracts"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./sources": {
      "types": "./sources.d.ts",
      "import": "./sources.js"
    },
    "./sources/node": {
      "types": "./node-sources.d.ts",
      "import": "./node-sources.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "sources.js",
    "sources.d.ts",
    "node-sources.js",
    "node-sources.d.ts",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
