{
  "name": "@baseblocks/anydoc",
  "version": "0.1.0-alpha.15",
  "description": "One-install AnyDoc ingestion and universal format-native viewers",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/BaseBlocks-HQ/anydoc.git", "directory": "packages/platform" },
  "exports": {
    ".": { "types": "./index.d.ts", "import": "./index.js" },
    "./node": { "types": "./node.d.ts", "import": "./node.js" },
    "./browser": { "types": "./browser.d.ts", "import": "./browser.js" },
    "./react": { "types": "./react.d.ts", "import": "./react.js" },
    "./spreadsheet": { "types": "./spreadsheet.d.ts", "import": "./spreadsheet.js" },
    "./presentation": { "types": "./presentation.d.ts", "import": "./presentation.js" },
    "./capabilities": { "types": "./capabilities.d.ts", "import": "./capabilities.js" },
    "./security": { "types": "./security.d.ts", "import": "./security.js" },
    "./ingestion": { "types": "./ingestion.d.ts", "import": "./ingestion.js" },
    "./ingestion/conformance": { "types": "./ingestion-conformance.d.ts", "import": "./ingestion-conformance.js" },
    "./persistence": { "types": "./persistence.d.ts", "import": "./persistence.js" },
    "./sources": { "types": "./sources.d.ts", "import": "./sources.js" },
    "./sources/node": { "types": "./sources-node.d.ts", "import": "./sources-node.js" },
    "./memory": { "types": "./memory.d.ts", "import": "./memory.js" }
  },
  "files": ["*.js", "*.d.ts", "README.md", "LICENSE", "NOTICE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "dependencies": { "@baseblocks/anydoc-ingestion": "workspace:0.1.0-alpha.15" },
  "optionalDependencies": {
    "@baseblocks/anydoc-presentation-viewer": "workspace:0.1.0-alpha.15",
    "@baseblocks/anydoc-react-viewer": "workspace:0.1.0-alpha.15",
    "@baseblocks/anydoc-spreadsheet-engine": "workspace:0.1.0-alpha.15",
    "@baseblocks/anydoc-spreadsheet-viewer": "workspace:0.1.0-alpha.15",
    "@firecrawl/anydoc-wasm": "0.1.8"
  },
  "peerDependencies": { "react": ">=18" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": { "test": "node --test test/*.test.mjs", "typecheck": "tsc --noEmit -p tsconfig.json" }
}
