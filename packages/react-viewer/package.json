{
  "name": "@baseblocks/anydoc-react-viewer",
  "version": "0.1.0-alpha.12",
  "description": "Safe, lazy React viewers for PDF, DOCX, text, and Markdown documents",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "NOTICE", "LICENSES", "THIRD_PARTY_NOTICES.md"],
  "repository": { "type": "git", "url": "https://github.com/BaseBlocks-HQ/anydoc.git", "directory": "packages/react-viewer" },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup && cp ../../node_modules/pdfjs-dist/build/pdf.worker.min.mjs dist/pdf.worker.min.mjs",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": { "node": ">=22.13.0" },
  "peerDependencies": {
    "@baseblocks/anydoc-presentation-viewer": "workspace:*",
    "@baseblocks/anydoc-spreadsheet-viewer": "workspace:*",
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "peerDependenciesMeta": {
    "@baseblocks/anydoc-presentation-viewer": { "optional": true },
    "@baseblocks/anydoc-spreadsheet-viewer": { "optional": true }
  },
  "dependencies": {
    "@baseblocks/anydoc-contracts": "workspace:*",
    "@zip.js/zip.js": "2.8.31",
    "@tanstack/react-virtual": "^3.13.12",
    "docx-preview": "^0.3.7",
    "github-slugger": "^2.0.0",
    "pdfjs-dist": "6.2.108",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
