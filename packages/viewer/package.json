{
  "name": "@baseblocks/anydoc-viewer",
  "version": "0.2.0-alpha.4",
  "description": "Framework-neutral document viewer engine and React adapter for AnyDoc",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/BaseBlocks-HQ/anydoc.git",
    "directory": "packages/viewer"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-spreadsheet-wasm.mjs && tsc -p tsconfig.build.json && cp ../../node_modules/pdfjs-dist/build/pdf.worker.min.mjs dist/viewers/pdf.worker.min.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "peerDependencies": {
    "react": ">=18.2",
    "react-dom": ">=18.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@baseblocks/anydoc-contracts": "workspace:0.2.0-alpha.4",
    "@aiden0z/pptx-renderer": "1.2.4",
    "@tanstack/react-virtual": "^3.13.12",
    "@zip.js/zip.js": "2.8.31",
    "docx-preview": "^0.3.7",
    "echarts": "6.1.0",
    "github-slugger": "^2.0.0",
    "pdfjs-dist": "6.2.108",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  }
}
