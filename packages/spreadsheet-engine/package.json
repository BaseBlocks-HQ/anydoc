{
  "name": "@baseblocks/anydoc-spreadsheet-engine",
  "version": "0.1.0-alpha.11",
  "description": "Bounded OOXML spreadsheet model and read engine for AnyDoc",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/BaseBlocks-HQ/anydoc.git", "directory": "packages/spreadsheet-engine" },
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./document-runtime": {
      "types": "./dist/document-adapter.d.ts",
      "import": "./dist/document-adapter.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@baseblocks/anydoc-contracts": "workspace:*",
    "@zip.js/zip.js": "2.8.31",
    "saxes": "5.0.1"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
