{
  "name": "@baseblocks/anydoc-presentation-viewer",
  "version": "0.1.0-alpha.9",
  "description": "Safe, lazy React viewer for PowerPoint presentations",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BaseBlocks-HQ/anydoc.git",
    "directory": "packages/presentation-viewer"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "check-types": "tsc --noEmit",
