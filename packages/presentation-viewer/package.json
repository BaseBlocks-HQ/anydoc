    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@baseblocks/anydoc-contracts": "workspace:*",
    "@aiden0z/pptx-renderer": "1.2.4"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
